{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["liveactivitytracking"],
  "ios": {
    "iosModuleName": "NitroLiveActivityTracking"
  },
  "android": {
    "androidNamespace": ["liveactivitytracking"],
    "androidCxxLibName": "NitroLiveActivityTracking"
  },
  "autolinking": {
    "LiveActivityTracking": {
      "ios": { "language": "swift", "implementationClassName": "HybridLiveActivityTracking" },
      "android": { "language": "kotlin", "implementationClassName": "HybridLiveActivityTracking" }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
