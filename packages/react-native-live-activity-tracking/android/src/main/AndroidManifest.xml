<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for any foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required for foregroundServiceType="location" on API 34+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Shows the ongoing notification on API 33+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required for Promoted Ongoing Notifications on API 36+ -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application>
        <service
            android:name="com.liveactivitytracking.LiveActivityService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
