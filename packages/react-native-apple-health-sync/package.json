{
  "name": "react-native-apple-health-sync",
  "version": "0.0.1-beta.1",
  "description": "Apple HealthKit sync for React Native (Nitro module, iOS only): reads workouts, routes, laps, heart-rate/cadence/distance series and observes new workouts, with EVERY workout sport mapped by name and by a stable id.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "src/index",
  "source": "src/index",
  "scripts": {
    "codegen": "nitrogen",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "keywords": ["react-native", "nitro", "healthkit", "apple-health", "workout", "ios"],
  "files": [
    "src",
    "nitrogen",
    "nitro.json",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.swift",
    "ios/PrivacyInfo.xcprivacy",
    "*.podspec",
    "README.md"
  ],
  "license": "MIT",
  "author": "Nguyễn Công Tuấn",
  "homepage": "https://github.com/OWNER/RNPackage",
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.37.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^19.1.0",
    "jest": "^29.7.0",
    "nitrogen": "0.37.2",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-nitro-modules": "0.37.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3"
  }
}
