{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "applehealthsync"
  ],
  "ios": {
    "iosModuleName": "NitroAppleHealthSync"
  },
  "autolinking": {
    "AppleHealthSync": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridAppleHealthSync"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ],
  "android": {
    "androidNamespace": [
      "applehealthsync"
    ],
    "androidCxxLibName": "NitroAppleHealthSync"
  }
}
